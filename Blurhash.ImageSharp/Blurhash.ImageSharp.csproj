<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <PackageReference Include="Blurhash.Core" Version="4.0.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    </ItemGroup>
   
    <PropertyGroup>
        <!-- This should be in sync with the TFMs of SixLabors.ImageSharp -->
        <TargetFrameworks>net6.0</TargetFrameworks>

        <PackageId>Blurhash.ImageSharp</PackageId>
        <Authors>Markus Palcer</Authors>
        <Description>BlurHash is a compact representation of a placeholder for an image.</Description>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <Copyright>Copyright 2019 Markus Palcer</Copyright>
        <PackageTags>blurhash image preview compression encoding</PackageTags>
        <PackageProjectUrl>https://github.com/MarkusPalcer/blurhash.net</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <Target Name="SetPackageVersion" BeforeTargets="GenerateNuspec;GetPackageVersion;_GetProjectReferenceVersions;GetAssemblyVersion;BeforeCompile">
        <PropertyGroup>
            <PackageVersion>@(PackageReference->WithMetadataValue('Identity', 'SixLabors.ImageSharp')->Metadata('Version'))</PackageVersion>
            <Version>$(PackageVersion)</Version>
        </PropertyGroup>
    </Target>
</Project>
